[Unit]
Description=IT Helpdesk Web (Flask via Gunicorn)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/it-helpdesk/web
EnvironmentFile=/etc/it-helpdesk/helpdesk.env
ExecStart=/opt/it-helpdesk/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5000 wsgi:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
