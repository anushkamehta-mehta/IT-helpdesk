[Unit]
Description=IT Helpdesk API (FastAPI)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/it-helpdesk/api
EnvironmentFile=/etc/it-helpdesk/helpdesk.env
ExecStart=/opt/it-helpdesk/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers
Restart=on-failure

[Install]
WantedBy=multi-user.target
