# Copy to /etc/it-helpdesk/helpdesk.env on the server (chmod 600, owned by the service user).
# Values come from AWS Secrets Manager / SSM Parameter Store, never from git.
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=3306
DB_USER=helpdesk_app
DB_PASSWORD=
DB_NAME=it_helpdesk
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
COOKIE_SECURE=true
CORS_ORIGINS=
FLASK_SECRET_KEY=
API_BASE_URL=
