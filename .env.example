# Copy to .env and fill in real values. NEVER commit .env.

# --- Database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=helpdesk_app
DB_PASSWORD=change_me
DB_NAME=it_helpdesk
# Hosted MySQL (e.g. Aiven) needs SSL: download the CA certificate (ca.pem) from the service's
# Overview page, put it in the project root and set DB_SSL_CA=ca.pem. Leave empty for local MySQL.
# Aiven example: DB_HOST=mysql-xxxx.aivencloud.com  DB_PORT=<port shown by Aiven>  DB_USER=avnadmin
DB_SSL_CA=

# --- API (FastAPI) ---
# Long random string used to sign login tokens.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=60
# false for local http development, MUST be true behind HTTPS (production)
COOKIE_SECURE=false
# Extra origins allowed to call the API from a browser (comma separated).
# Leave empty: the pages and the API are served by the same app on one origin.
CORS_ORIGINS=

# --- Email (SMTP): the requester is emailed when a ticket is Resolved ---
# Leave SMTP_HOST empty to turn email off.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com and an App Password
# (Google Account > Security > 2-Step Verification > App passwords), not your normal password.
# Outlook / Office 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587.
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Sender address shown to employees; defaults to SMTP_USER
SMTP_FROM=
# Brevo (brevo.com) email API key. When set, emails go through Brevo over HTTPS instead of SMTP.
# Needed on Render's free plan, which blocks SMTP ports. SMTP_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
# Address of the helpdesk, used for the ticket link in emails
APP_BASE_URL=http://127.0.0.1:8000
