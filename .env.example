# Copy to .env and fill in real values. NEVER commit .env.

# --- Database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=helpdesk_app
DB_PASSWORD=change_me
DB_NAME=it_helpdesk

# --- API (FastAPI) ---
# Long random string used to sign login tokens.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=60
# false for local http development, MUST be true behind HTTPS (production)
COOKIE_SECURE=false
# Origins allowed to call the API from a browser in development (comma separated).
# Leave empty in production (Nginx serves web and API from one origin).
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# --- Web (Flask) ---
FLASK_SECRET_KEY=change_me_to_another_long_random_string
# Where the browser finds the API. Empty = same origin (production behind Nginx).
# In development use the SAME host name you browse with (127.0.0.1 or localhost, not a mix).
API_BASE_URL=http://127.0.0.1:8000
